# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite DB & journals â€?NEVER commit production data
/prisma/dev.db
/prisma/dev.db-journal
/prisma/*.db
/prisma/*.db-journal

# user-uploaded media (logos, backgrounds, project covers) â€?runtime content
/public/uploads/*
!/public/uploads/.gitkeep

# Claude Code workspace state

# pi helper scripts (use env-var SSH_PASSWORD, never commit deploy creds)
/scripts/_pi_ssh.py
/.claude/
CLAUDE.md

# Playwright MCP ephemeral state (page snapshots, console logs)
/.playwright-mcp/

# One-shot migration patchers
/scripts/_patch_*.py

